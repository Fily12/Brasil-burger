<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <title>{% block title %}Connexion — Brasil Burger{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #FFFFFF;
        height: 100vh;
        width: 100vw;
        display: flex;
      }

      .branding {
        background-color: #1A1A1A;
        width: 45%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .branding img {
        max-width: 220px;
      }

      .form-zone {
        background-color: #FFFFFF;
        width: 55%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .form-box {
        background-color: #FFD700;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 400px;
      }

      .form-box h2 {
        text-align: center;
        margin-bottom: 30px;
      }

      .form-box .form-label {
        font-weight: bold;
      }

      .form-box .forgot-link {
        display: block;
        text-align: right;
        margin-top: 10px;
        font-size: 0.9rem;
        color: #000;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="branding">
      <img src="{{ asset('images/brasil-burger-logo.png') }}" alt="Brasil Burger">
    </div>
    <div class="form-zone">
      {% block body %}{% endblock %}
    </div>
  </body>
</html>
