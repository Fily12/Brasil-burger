{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="dashboard-wrapper">

    <!-- Barre latérale -->
    <aside class="sidebar" style="background-color: #1A1A1A; color: white; width: 220px; height: 100vh; position: fixed;">
        <div class="sidebar-header" style="padding: 20px;">
            <h2 style="color: white;">Gestionnaire</h2>
        </div>
        <nav class="sidebar-menu">
            <ul style="list-style: none; padding: 0;">
                <li style="background-color: #FFD700; padding: 10px;"><a href="#" style="color: black; text-decoration: none;">Tableau de bord</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Burgers</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Menus</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Complément</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Commande</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Livraison</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Paiement</a></li>
                <li style="padding: 10px;"><a href="#" style="color: white; text-decoration: none;">Paramètres</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Contenu principal -->
    <main class="dashboard-main" style="margin-left: 240px; padding: 20px;">

        <!-- Barre de recherche -->
        <div class="search-bar" style="display: flex; align-items: center; border: 1px solid #FFD700; padding: 8px; margin-bottom: 20px;">
            <span style="color: #FFD700; margin-right: 10px;">🔍</span>
            <input type="text" placeholder="Rechercher..." style="flex: 1; border: none; outline: none;">
            <span style="color: #FFD700; margin-left: 10px;">⚙️</span>
        </div>

        <!-- Cartes de statistiques -->
        <section class="stats-cards" style="display: flex; gap: 20px; margin-bottom: 30px;">
            <div class="card" style="flex: 1; background: #fff; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <h4>Commandes en cours</h4>
                <p>12 <span style="color: green;">+3 vs hier</span></p>
            </div>
            <div class="card" style="flex: 1; background: #fff; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <h4>Commandes validées</h4>
                <p>45 <span style="color: green;">+12 vs hier</span></p>
            </div>
            <div class="card" style="flex: 1; background: #fff; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <h4>Commandes annulées</h4>
                <p>2 <span style="color: red;">-1 vs hier</span></p>
            </div>
            <div class="card" style="flex: 1; background: #fff; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <h4>Recettes du jour</h4>
                <p>125 000 FCFA <span style="color: green;">+18% vs hier</span></p>
            </div>
        </section>

        <!-- Graphique des produits -->
        <section style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-bottom: 30px;">
            <h4>Produits les plus vendus</h4>
            <canvas id="produitsChart"></canvas>
        </section>

        <!-- Commandes récentes -->
        <section style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            <h4>Commandes récentes</h4>
            <ul style="list-style: none; padding: 0;">
                <li>Mamadou Diop – #001 – Livraison – 8 500 FCFA – <span style="background-color: #4285F4; color: white; padding: 2px 6px; border-radius: 4px;">En cours</span></li>
                <li>Awa Seck – #002 – À récupérer – 12 000 FCFA – <span style="background-color: #4CAF50; color: white; padding: 2px 6px; border-radius: 4px;">Validée</span></li>
                <li>Ibrahima Fall – #003 – Sur place – 6 500 FCFA – <span style="background-color: #4285F4; color: white; padding: 2px 6px; border-radius: 4px;">En cours</span></li>
                <li>Fatou Ndour – #004 – Livraison – 15 500 FCFA – <span style="background-color: #4285F4; color: white; padding: 2px 6px; border-radius: 4px;">En cours</span></li>
            </ul>
        </section>

    </main>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('produitsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Classic Burger', 'Cheese Burger', 'Brasil Burger', 'Menu Classic', 'Menu Brasil'],
            datasets: [{
                label: 'Ventes',
                data: [30, 25, 60, 20, 50],
                backgroundColor: '#4CAF50'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
{% endblock %}
