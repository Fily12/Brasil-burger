{% extends 'admin/layout_admin.html.twig' %}

{% block title %}Liste des Burgers{% endblock %}

{% block body %}
<div class="bg-white p-4 rounded shadow-sm">
    <h2 class="mb-4">Liste des Burgers</h2>

    <a href="{{ path('admin_burgers_ajouter') }}" class="btn btn-success mb-3">➕ Ajouter un burger</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for burger in burgers %}
            <tr>
                <td>{{ burger.nom }}</td>
                <td>{{ burger.description }}</td>
                <td>{{ burger.prix }} FCFA</td>
                <td>
                    <img src="{{ burger.imagePath }}" alt="{{ burger.nom }}" width="80">
                </td>
                <td>
                    <a href="{{ path('admin_burgers_modifier', {id: burger.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                    <a href="{{ path('admin_burgers_archiver', {id: burger.id}) }}" class="btn btn-danger btn-sm">Archiver</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun burger trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
