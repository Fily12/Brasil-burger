{% extends 'admin/layout_admin.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="bg-white p-4 rounded shadow-sm">
  <h2 class="mb-4 fw-bold">Bienvenue sur le tableau de bord</h2>

  <!-- Barre de recherche -->
  <div class="d-flex align-items-center mb-4" style="max-width: 500px;">
    <span class="me-2 text-warning fs-5">🔍</span>
    <input type="text" class="form-control me-2" placeholder="Rechercher..." style="border: 2px solid #FFD700;">
    <span class="ms-2 text-warning fs-5">⚙️</span>
  </div>

  <!-- Cartes de statistiques -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <div class="fs-2 text-primary">🛒</div>
        <h6 class="mt-2">Commandes en cours</h6>
        <p class="mb-0">12 <span class="text-success">+3 vs hier</span></p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <div class="fs-2 text-success">✅</div>
        <h6 class="mt-2">Commandes validées</h6>
        <p class="mb-0">45 <span class="text-success">+12 vs hier</span></p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <div class="fs-2 text-danger">❌</div>
        <h6 class="mt-2">Commandes annulées</h6>
        <p class="mb-0">2 <span class="text-danger">-1 vs hier</span></p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <div class="fs-2 text-warning">💰</div>
        <h6 class="mt-2">Recettes du jour</h6>
        <p class="mb-0">125 000 FCFA <span class="text-success">+18%</span></p>
      </div>
    </div>
  </div>

  <!-- Section côte à côte -->
  <div class="row g-4">
    <!-- Produits les plus vendus -->
    <div class="col-md-6">
      <div class="card shadow-sm p-4 h-100">
        <h5 class="fw-bold mb-3">Produits les plus vendus</h5>
        <canvas id="produitsChart"></canvas>
      </div>
    </div>

    <!-- Commandes récentes -->
    <div class="col-md-6">
      <div class="card shadow-sm p-4 h-100">
        <h5 class="fw-bold mb-3">Commandes récentes</h5>
        <ul class="list-unstyled">
          <li class="mb-2">Mamadou Diop – #001 – Livraison – 8 500 FCFA – <span class="badge bg-primary">En cours</span></li>
          <li class="mb-2">Awa Seck – #002 – À récupérer – 12 000 FCFA – <span class="badge bg-success">Validée</span></li>
          <li class="mb-2">Ibrahima Fall – #003 – Sur place – 6 500 FCFA – <span class="badge bg-primary">En cours</span></li>
          <li class="mb-2">Fatou Ndour – #004 – Livraison – 15 500 FCFA – <span class="badge bg-primary">En cours</span></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('produitsChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Classic Burger', 'Cheese Burger', 'Brasil Burger', 'Menu Classic', 'Menu Brasil'],
      datasets: [{
        label: 'Ventes',
        data: [45, 35, 50, 30, 45],
        backgroundColor: '#4CAF50'
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });
</script>
{% endblock %}
