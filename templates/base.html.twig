<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin - Brasil Burger{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍔</text></svg>">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f0f8ff;
        }
        .sidebar {
            background-color: #343a40;
            min-height: 100vh;
            padding-top: 20px;
        }
        .sidebar a {
            color: #fff;
            padding: 10px 15px;
            display: block;
            text-decoration: none;
        }
        .sidebar a:hover {
            background-color: #495057;
        }
        .sidebar .active {
            background-color: #ffc107;
            color: #000;
        }
        .avatar {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 50%;
            margin: 0 auto 10px;
            display: block;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 sidebar text-center">
    <img src="{{ asset('images/gestionnaire-avatar.png') }}" alt="Gestionnaire" class="avatar">
    <h5 class="text-white mb-4"> Gestionnaire</h5>
    <a href="{{ path('admin_dashboard') }}">Tableau de bord</a>
    <a href="{{ path('admin_burgers_index') }}" class="active">Burgers</a>
    <a href="{{ path('admin_menus') }}">Menus</a>
    <a href="{{ path('admin_complement') }}">Complément</a>
    <a href="{{ path('admin_commandes') }}">Commandes</a>
    <a href="{{ path('admin_livraison') }}">Livraison</a>
    <a href="{{ path('admin_paiement') }}">Paiement</a>
    <a href="{{ path('admin_parametres') }}">Paramètres</a>
</nav>


            <!-- Main content -->
            <main class="col-md-10 p-4">
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>
