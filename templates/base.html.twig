<?php

namespace App\Controller;

use App\Entity\Menu;
use App\Form\MenuType;
use App\Repository\MenuRepository;
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Annotation\Route;

#[Route('/gestionnaire/menus')]
class MenuController extends AbstractController
{
    // Liste des menus (page principale)
    #[Route('/', name: 'admin_menus', methods: ['GET'])]
    public function index(MenuRepository $menuRepository): Response
    {
        $menus = $menuRepository->findAllWithArchived();

        return $this->render('menu/index.html.twig', [
            'menus' => $menus,
        ]);
    }

    // Création d'un nouveau menu
    #[Route('/nouveau', name: 'admin_menu_new', methods: ['GET', 'POST'])]
    public function new(Request $request, EntityManagerInterface $entityManager): Response
    {
        $menu = new Menu();
        $form = $this->createForm(MenuType::class, $menu);
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            // Gestion de l'upload d'image
            $imageFile = $form->get('imageFile')->getData();
            if ($imageFile) {
                $newFilename = 'menu_' . uniqid() . '.' . $imageFile->guessExtension();
                $imageFile->move(
                    $this->getParameter('kernel.project_dir') . '/public/images/menus',
                    $newFilename
                );
                $menu->setImage($newFilename);
            }

            $entityManager->persist($menu);
            $entityManager->flush();

            $this->addFlash('success', 'Le menu a été créé avec succès.');
            return $this->redirectToRoute('admin_menus');
        }

        return $this->render('menu/form.html.twig', [
            'menu' => $menu,
            'form' => $form,
            'isEdit' => false,
        ]);
    }

    // Modification d'un menu
    #[Route('/{id}/modifier', name: 'admin_menu_edit', methods: ['GET', 'POST'])]
    public function edit(Request $request, Menu $menu, EntityManagerInterface $entityManager): Response
    {
        $form = $this->createForm(MenuType::class, $menu);
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            // Gestion de l'upload d'image
            $imageFile = $form->get('imageFile')->getData();
            if ($imageFile) {
                $newFilename = 'menu_' . uniqid() . '.' . $imageFile->guessExtension();
                $imageFile->move(
                    $this->getParameter('kernel.project_dir') . '/public/images/menus',
                    $newFilename
                );
                $menu->setImage($newFilename);
            }

            $entityManager->flush();

            $this->addFlash('success', 'Le menu a été modifié avec succès.');
            return $this->redirectToRoute('admin_menus');
        }

        return $this->render('menu/form.html.twig', [
            'menu' => $menu,
            'form' => $form,
            'isEdit' => true,
        ]);
    }

    // Archivage d'un menu
    #[Route('/{id}/archiver', name: 'admin_menu_archive', methods: ['POST'])]
    public function archive(Menu $menu, EntityManagerInterface $entityManager): Response
    {
        $menu->setArchive(!$menu->isArchive());
        $entityManager->flush();

        $message = $menu->isArchive() 
            ? 'Le menu a été archivé avec succès.' 
            : 'Le menu a été désarchivé avec succès.';
        
        $this->addFlash('success', $message);
        return $this->redirectToRoute('admin_menus');
    }

    // Suppression définitive d'un menu
    #[Route('/{id}/supprimer', name: 'admin_menu_delete', methods: ['POST'])]
    public function delete(Menu $menu, EntityManagerInterface $entityManager): Response
    {
        $entityManager->remove($menu);
        $entityManager->flush();

        $this->addFlash('success', 'Le menu a été supprimé définitivement.');
        return $this->redirectToRoute('admin_menus');
    }
}