@model Brasil_BurgerC.Models.Paiement

@{
    ViewData["Title"] = "Paiement";
}

<h2>Effectuer un paiement 💳</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Mode">Mode de paiement</label>
        <input asp-for="Mode" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Montant">Montant</label>
        <input asp-for="Montant" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success mt-3">Valider</button>
</form>
