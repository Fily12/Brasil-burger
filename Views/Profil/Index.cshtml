@model Brasil_BurgerC.Models.Profil

@{
    ViewData["Title"] = "Profil utilisateur";
}

<div class="container mt-4">
    <h2 class="mb-4">Profil 👤</h2>

    <div class="card p-4">
        <div class="d-flex align-items-center mb-4">
            <img src="/images/profil.jpg" class="rounded-circle" width="80" height="80" alt="Photo de profil" />
            <h4 class="ms-3">@Model.Nom <a href="#"><i class="bi bi-pencil"></i></a></h4>
        </div>

        <form asp-action="Index" method="post">
            <div class="form-group mb-3">
                <label><i class="bi bi-telephone"></i> Téléphone</label>
                <input asp-for="Telephone" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label><i class="bi bi-geo-alt"></i> Localisation</label>
                <input asp-for="Localisation" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </form>

        <div class="text-end mt-4">
            <a asp-action="Logout" class="btn btn-danger">Déconnexion ➔</a>
        </div>
    </div>
</div>
