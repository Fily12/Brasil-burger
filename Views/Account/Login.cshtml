@model Brasil_BurgerC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="d-flex justify-content-center align-items-center" style="height:100vh; background-color:#000;">
    <div style="width:400px; color:white;">
        <h2 class="text-center mb-4">Bienvenue!</h2>
        <p class="text-center">Connectez-vous à votre compte!</p>

        <form asp-action="Login" method="post">
            <div class="form-group mb-3">
                <label asp-for="EmailOrPhone" class="form-label"></label>
                <input asp-for="EmailOrPhone" class="form-control" placeholder="Email ou Numéro de téléphone" />
                <span asp-validation-for="EmailOrPhone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" type="password" placeholder="Mot de passe" />
                    <span class="input-group-text"><i class="bi bi-eye"></i></span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning w-100">Connexion</button>
        </form>

        <p class="mt-3 text-center">
            Vous n'avez pas de compte ? 
            <a href="#" style="color:yellow;">Inscrivez-vous</a>
        </p>
    </div>
</div>
